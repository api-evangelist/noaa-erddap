          "id": "98dbb37e-ba98-4260-a154-f91365ff1be1",
          "name": "Download a subset of a tabular dataset",
          "request": {
            "name": "Download a subset of a tabular dataset",
            "description": {
              "content": "Retrieves in-situ, station, trajectory, or profile data (CDM types\nother than Grid).\n\n**Query string structure:** `?variables&constraints`\n\n- `variables` — comma-separated variable names; omit for all variables.\n- `constraints` — `&varName>=value` pairs appended after the variable list.\n\n**Special result modifiers (append to query):**\n- `&distinct()` — return only unique rows.\n- `&orderBy(\"var1,var2\")` — sort results.\n- `&orderByMax(\"var1\")` — keep only the row with the max value per group.\n- `&units(\"UDUNITS\")` — convert units.\n\nAlways call `/info/{datasetID}/index.json` first to discover valid\nvariable names and coordinate ranges.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tabledap",
                "{{datasetID}}.{{fileType}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "variables",
                  "value": "<string>",
                  "description": "Comma-separated variable names to include in the response.\nOmit to return all variables.\n"
                },
                {
                  "disabled": false,
                  "key": "time>=",
                  "value": "<string>",
                  "description": "Lower time bound (ISO 8601 or `now-Nunit` expression)."
                },
                {
                  "disabled": false,
                  "key": "time<=",
                  "value": "<string>",
                  "description": "Upper time bound."
                },
                {
                  "disabled": false,
                  "key": "latitude>=",
                  "value": "<number>"
                },
                {
                  "disabled": false,
                  "key": "latitude<=",
                  "value": "<number>"
                },
                {
                  "disabled": false,
                  "key": "longitude>=",
                  "value": "<number>"
                },
                {
                  "disabled": false,
                  "key": "longitude<=",
                  "value": "<number>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/csv"
              }
            ],
            "method": "GET",
            "auth": null
          },
